# Copy to .env. Keys stay on this local server and are never sent to the browser.
TYPESAFE_API_KEY=
OPENAI_API_KEY=

# Explicit opt-in: set a chosen USD ceiling to allow paid work. Zero disables dispatch.
# This is a durable allowance for this save, shared by conversation, invention and NPCs.
AI_BUDGET_USD=0
# Only Jev decisions and native execution; disable generation, embeddings and model maintenance.
AI_JEV_ONLY=false
JEV_MODEL=jev-1.13.0
OPENAI_MODEL=gpt-5.6-luna

PORT=3211
# Local mode is loopback-only. See README.md for OIDC setup and exact account bindings.
OPEN_LEGEND_AUTH_MODE=local
OPEN_LEGEND_HOST=127.0.0.1
# OPEN_LEGEND_PUBLIC_ORIGIN=https://world.example.org
# OPEN_LEGEND_OIDC_ISSUER=https://identity.example.org/realms/openlegend
# OPEN_LEGEND_OIDC_CLIENT_ID=openlegend
# OPEN_LEGEND_OIDC_CLIENT_SECRET=
# OPEN_LEGEND_ACCOUNT_BINDINGS=[]
# OPEN_LEGEND_SESSION_HOURS=8
# OPEN_LEGEND_EXIT_GRACE_SECONDS=15
# OPEN_LEGEND_OIDC_LOOPBACK_HTTP=false
WORLD_SEED=1086
OPEN_LEGEND_DATA_DIR=.data
AI_TIMEOUT_SECONDS=35

# Verified standard prices when this adapter was implemented; estimates, not invoices.
# Set every LLM rate explicitly if changing OPENAI_MODEL. See docs/ai-providers.md.
JEV_INPUT_USD_PER_MILLION=0.042
LLM_INPUT_USD_PER_MILLION=0.20
LLM_OUTPUT_USD_PER_MILLION=1.20
LLM_CACHED_INPUT_USD_PER_MILLION=0.02
LLM_CACHE_WRITE_USD_PER_MILLION=0.25

# Optional exact-model catalogue for named decision/summary models. Rates below are illustrative.
# Default OPENAI_MODEL keeps the LLM_* rates above; unknown models keep conservative accounting.
# OPENAI_MODEL_PRICES_JSON=[{"model":"operator-model","prices":{"inputUsdPerMillion":1,"outputUsdPerMillion":2},"reportedAliases":["operator-model-revision"]}]

# Reserves cannot fall below the application's conservative configured-rate bound.
JEV_CALL_RESERVE_USD=0.005
LLM_CALL_RESERVE_USD=0.08

# Macrofold backend integration (takes precedence over direct provider adapters).
MACROFOLD_BASE_URL=http://localhost:3210
MACROFOLD_API_KEY=
# The same backend key authenticates runs and Jev inference.
# Inference needs no workspace selector. Open Legend provisions one workspace/worktree per NPC.
MACROFOLD_MODEL=meta/muse-spark-1.3-contributor
MACROFOLD_HARNESS=opencode
MACROFOLD_RUN_MAX_USD=0.25
# Native calls require an existing Worker selected by the application/world compute owner.
# Blank disables native execution only; /v1/inferences does not need a Worker.
# The owner manages Worker limits/credit/lifecycle in Macrofold. AI_BUDGET_USD and
# MACROFOLD_RUN_MAX_USD do NOT cap shared Worker compute. See docs/ai-providers.md.
MACROFOLD_WORKER_ID=
MACROFOLD_TIMEOUT_SECONDS=300

# Local owner-only private mind inspector. Do not enable for ordinary multiplayer clients.
OPEN_LEGEND_GOD_MODE=false
MACROFOLD_BILLING_MODE=byok
MACROFOLD_PROVIDER_CONNECTION_ID=
MACROFOLD_JEV_CONNECTION_ID=
MACROFOLD_JEV_MODEL=typesafe/jev-1.13

# Required for all local and production use. Install PostgreSQL with pgvector.
# Example: postgresql://localhost/openlegend; absent configuration fails startup.
OPEN_LEGEND_DATABASE_URL=
# Embeddings use OPENAI_API_KEY unless this separate key is configured.
# OPENAI_EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_CALL_RESERVE_USD=0.01

# Independent immediate and cleanup routes. Unknown model prices retain reservations.
COGNITION_MINI_MODEL=gpt-5-mini
COGNITION_COMPLEX_MODEL=gpt-5
COGNITION_SUMMARY_MODEL=gpt-5-nano
MACROFOLD_MINI_MODEL=openai/gpt-5-mini
MACROFOLD_COMPLEX_MODEL=openai/gpt-5
MACROFOLD_SUMMARY_MODEL=openai/gpt-5-nano

# Admission target, not a throughput guarantee. Coordinates connections/presence/API/session headroom.
OPEN_LEGEND_PLAYER_CAPACITY=100
# Shared cap across one optional workshop episode and its linked follow-ups; zero disables paid workshop turns.
INVENTION_WORKSHOP_MAX_USD=5

# Optional world-owner MCP connector. All blank disables /mcp; writes are opt-in below.
# Use a separate random bearer in Macrofold; store only its SHA-256 here.
# Exact world/expiry/Host binding; no Origin-bearing browser calls.
# Expose ONLY /mcp through authenticated HTTPS; never proxy all local owner routes.
# See docs/world-agent-mcp.md#implemented-read-only-bootstrap.
OPEN_LEGEND_MCP_TOKEN_SHA256=
OPEN_LEGEND_MCP_WORLD_ID=
OPEN_LEGEND_MCP_EXPIRES_AT=
OPEN_LEGEND_MCP_HOSTS=

# Enable reviewed writes only after approving these tools in the dedicated Macrofold connection.
# Read access remains world-bound; write calls additionally need an app-issued session handle.
OPEN_LEGEND_MCP_WRITES=false
MACROFOLD_WORLD_CONNECTION_ID=
# Native owner authoring uses managed billing so the run's provider charges share its ceiling.
# Existing NPC/typed-call MACROFOLD_BILLING_MODE is unchanged. Shared Worker costs are separately managed by the world operator.
MACROFOLD_WORLD_RUN_MAX_USD=1
MACROFOLD_WORLD_TIMEOUT_SECONDS=900
