# Copy to .env. Keys stay on this local server and are never sent to the browser.
TYPESAFE_API_KEY=
OPENAI_API_KEY=

# Explicit opt-in: set a chosen USD ceiling to allow paid work. Zero disables dispatch.
# This is a durable allowance for this save, shared by conversation, invention and NPCs.
AI_BUDGET_USD=0
JEV_MODEL=jev-1.13.0
OPENAI_MODEL=gpt-5.6-luna

PORT=3211
WORLD_SEED=1086
OPEN_LEGEND_DATA_DIR=.data
AI_TIMEOUT_SECONDS=35

# Verified standard prices when this adapter was implemented; estimates, not invoices.
# Set every LLM rate explicitly if changing OPENAI_MODEL. See docs/ai-providers.md.
JEV_INPUT_USD_PER_MILLION=0.042
LLM_INPUT_USD_PER_MILLION=0.20
LLM_OUTPUT_USD_PER_MILLION=1.20
LLM_CACHED_INPUT_USD_PER_MILLION=0.02
LLM_CACHE_WRITE_USD_PER_MILLION=0.25

# Reserves cannot fall below the application's conservative configured-rate bound.
JEV_CALL_RESERVE_USD=0.005
LLM_CALL_RESERVE_USD=0.08

# Macrofold backend integration (takes precedence over direct provider adapters).
MACROFOLD_BASE_URL=http://localhost:3210
MACROFOLD_API_KEY=
# The same backend key authenticates runs and Jev inference.
# Inference needs no workspace selector. Open Legend provisions one workspace/worktree per NPC.
MACROFOLD_MODEL=meta/muse-spark-1.3-contributor
MACROFOLD_HARNESS=opencode
MACROFOLD_RUN_MAX_USD=0.25
# Explicit compute allocation PER long-running sandbox, charged against AI_BUDGET_USD.
# Zero disables worker creation. No automatic credit renewal or paid retries.
MACROFOLD_COMPUTE_MAX_USD=0
MACROFOLD_TIMEOUT_SECONDS=300

# Local owner-only private mind inspector. Do not enable for ordinary multiplayer clients.
OPEN_LEGEND_GOD_MODE=false
MACROFOLD_BILLING_MODE=byok
MACROFOLD_PROVIDER_CONNECTION_ID=
MACROFOLD_JEV_CONNECTION_ID=
MACROFOLD_JEV_MODEL=typesafe/jev-1.13

# PostgreSQL is required for accepted workspace reflection; blank keeps SQLite native play.
OPEN_LEGEND_DATABASE_URL=
# Embeddings use OPENAI_API_KEY unless this separate key is configured.
# OPENAI_EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_CALL_RESERVE_USD=0.01

# Independent immediate and cleanup routes. Unknown model prices retain reservations.
COGNITION_MINI_MODEL=gpt-5-mini
COGNITION_COMPLEX_MODEL=gpt-5
COGNITION_SUMMARY_MODEL=gpt-5-nano
MACROFOLD_MINI_MODEL=openai/gpt-5-mini
MACROFOLD_COMPLEX_MODEL=openai/gpt-5
MACROFOLD_SUMMARY_MODEL=openai/gpt-5-nano

# Shared cap across one optional workshop episode and its linked follow-ups; zero disables paid workshop turns.
INVENTION_WORKSHOP_MAX_USD=5

# Optional READ-ONLY world-owner MCP connector. All blank disables /mcp.
# Use a separate random bearer in Macrofold; store only its SHA-256 here.
# Exact world/expiry/Host binding, no Origin-bearing browser calls or mutation tools.
# Expose ONLY /mcp through authenticated HTTPS; never proxy all local owner routes.
# See docs/world-agent-mcp.md#implemented-read-only-bootstrap.
OPEN_LEGEND_MCP_TOKEN_SHA256=
OPEN_LEGEND_MCP_WORLD_ID=
OPEN_LEGEND_MCP_EXPIRES_AT=
OPEN_LEGEND_MCP_HOSTS=
